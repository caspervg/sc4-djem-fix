#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SC4_RESOURCE_FILE_VERSION@,0
 PRODUCTVERSION @SC4_RESOURCE_FILE_VERSION@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SC4 DLL Template contributors\0"
            VALUE "FileDescription", "@PROJECT_NAME@ SimCity 4 plugin\0"
            VALUE "FileVersion", "@SC4_TEMPLATE_APP_VERSION@\0"
            VALUE "InternalName", "@PROJECT_NAME@\0"
            VALUE "OriginalFilename", "@PROJECT_NAME@.dll\0"
            VALUE "ProductName", "@PROJECT_NAME@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
